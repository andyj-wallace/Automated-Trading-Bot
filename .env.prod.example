# Production secrets for docker-compose.prod.yml. Copy to .env.prod (never commit it).
SECRET_KEY=
# URL-safe characters only (embedded in DATABASE_URL)
POSTGRES_PASSWORD=
# IBKR paper credentials
IBKR_USERNAME=
IBKR_PASSWORD=
VNC_PASSWORD=
# Daily Gateway restart (ET). Sunday's restart asks for the weekly IBKR Mobile approval,
# so pick a time you're awake. Keep it after 16:45 ET and before 23:00 ET (IBKR's nightly reset).
IB_AUTO_RESTART_TIME="07:00 PM"
NOTIFICATION_EMAIL_SMTP=
NOTIFICATION_SMS_TWILIO=

# Optional risk / engine settings (defaults in app/config.py)
# BROKER_PROTECTIVE_STOPS=true
# IBKR_MARKET_DATA_TYPE=1
# MAX_PORTFOLIO_RISK_PCT=
# MIN_REWARD_TO_RISK=
# DAILY_LOSS_LIMIT_PCT=
# MAX_CONSECUTIVE_LOSSES=
# STALE_TRADE_MAX_DAYS=
# ORDER_FILL_TIMEOUT_SECONDS=
# PRICE_STALE_SECONDS=
